generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model administradores {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  telefono        String?
  correo          String  @unique
  password        String
  rol             String?
  foto_perfil_url String?
  rutas           rutas[]
}

model choferes {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  licencia        String?
  correo          String  @unique
  password        String
  telefono        String?
  foto_perfil_url String?
  rutas           rutas[]
}

model clientes {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String
  telefono    String?
  direccion   String
  correo      String                   @unique
  coordenadas Unsupported("geography")
  codigo      String?
  contacto    String?
  estatus     String?                  @default("Activo")
  created_at  DateTime                 @default(now()) @db.Timestamp(6)
  pedidos     pedidos[]
}

model detalles_ruta {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruta_id        String?  @db.Uuid
  pedido_id      String?  @db.Uuid
  orden_entrega  Int?
  comentarios    String?
  estado_intento String   @default("pendiente")
  pedidos        pedidos? @relation(fields: [pedido_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rutas          rutas?   @relation(fields: [ruta_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model evidencias {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id           String?                   @db.Uuid
  foto_url            String?
  firma_url           String?
  coordenadas_entrega Unsupported("geography")?
  fecha_hora          DateTime?                 @default(now()) @db.Timestamptz(6)
  estado_evidencia    String?                   @default("alerta")
  pedidos             pedidos?                  @relation(fields: [pedido_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model incidencias {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruta_id               String?                   @db.Uuid
  pedido_id             String?                   @db.Uuid
  tipo                  String?
  descripcion           String?
  foto_url              String?
  coordenadas_incidente Unsupported("geography")?
  estado_incidencia     String?                   @default("pendiente")
  categoria             String                    @default("camino")
  created_at            DateTime                  @default(now()) @db.Timestamp(6)
  updated_at            DateTime                  @default(now()) @db.Timestamp(6)
  pedidos               pedidos?                  @relation(fields: [pedido_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rutas                 rutas?                    @relation(fields: [ruta_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([coordenadas_incidente], map: "idx_incidencias_coordenadas", type: Gist)
}

model pedidos {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id        String?         @db.Uuid
  descripcion_carga String?
  codigo_rastreo    String
  estado_pedido     String?         @default("pendiente")
  created_at        DateTime        @default(now()) @db.Timestamp(6)
  updated_at        DateTime        @default(now()) @db.Timestamp(6)
  detalles_ruta     detalles_ruta[]
  evidencias        evidencias[]
  incidencias       incidencias[]
  clientes          clientes?       @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model rutas {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehiculo_id              String?                @db.Uuid
  chofer_id                String?                @db.Uuid
  creado_por               String?                @db.Uuid
  fecha_programada         DateTime?              @db.Date
  distancia_total_estimada Decimal?               @db.Decimal
  tiempo_estimado_entrega  DateTime?              @db.Timestamptz(6)
  estatus_ruta             String?                @default("borrador")
  created_at               DateTime               @default(now()) @db.Timestamp(6)
  updated_at               DateTime               @default(now()) @db.Timestamp(6)
  codigo_rastreo           String                 @unique
  detalles_ruta            detalles_ruta[]
  incidencias              incidencias[]
  choferes                 choferes?              @relation(fields: [chofer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  administradores          administradores?       @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehiculos                vehiculos?             @relation(fields: [vehiculo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trayectos_finalizados    trayectos_finalizados?
  ubicacion_actual         ubicacion_actual?
}

model vehiculos {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placas                  String   @unique
  marca                   String?
  modelo                  String?
  rendimiento_combustible Decimal? @db.Decimal
  estatus                 String?  @default("disponible")
  foto_unidad_url         String?
  rutas                   rutas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model trayectos_finalizados {
  id                 Int                      @id @default(autoincrement())
  ruta_id            String                   @unique @db.Uuid
  geometria_ruta     Unsupported("geography")
  distancia_total_km Float?
  fecha_inicio       DateTime?                @db.Timestamptz(6)
  fecha_fin          DateTime?                @default(now()) @db.Timestamptz(6)
  rutas              rutas                    @relation(fields: [ruta_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ruta_finalizada")

  @@index([geometria_ruta], map: "idx_trayectos_geog", type: Gist)
}

model ubicacion_actual {
  ruta_id             String                   @id @db.Uuid
  ultima_coordenada   Unsupported("geography")
  fecha_actualizacion DateTime?                @default(now()) @db.Timestamptz(6)
  velocidad_kmh       Float?
  nivel_bateria       Int?
  rutas               rutas                    @relation(fields: [ruta_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ruta_actual")

  @@index([ultima_coordenada], map: "idx_ubicacion_actual_geog", type: Gist)
}

model reportes {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar(255)
  periods     String   @db.VarChar(50)
  startdate   DateTime @db.Timestamp(6)
  enddate     DateTime @db.Timestamp(6)
  fileurl     String
  createdbyid String
  createdat   DateTime @default(now()) @db.Timestamp(6)
}
